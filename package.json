{
  "name": "burro_dos_concertos",
  "version": "1.0.0",
  "description": "telegram concert manager bot",
  "main": "dist/bot.js",
  "exports": "./dist/bot.js",
  "imports": {
    "#/*": "./src/*"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "keywords": [
    "concerts",
    "telegram",
    "bot"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsx --watch src/bot.ts",
    "dev:test": "NODE_ENV=test tsx --watch src/bot.ts",
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc && tsc-alias",
    "start": "node dist/bot.js",
    "test": "NODE_OPTIONS='--localstorage-file=./jest-storage' jest",
    "test:coverage": "NODE_OPTIONS='--localstorage-file=./jest-storage' jest --coverage",
    "test:ci": "NODE_OPTIONS='--localstorage-file=./jest-storage' jest --ci",
    "test:watch": "jest --watch",
    "format": "prettier --write \"src/**/*\" \"web/src/**/*\"",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "pnpm lint --fix",
    "seed": "node dist/prisma/seed.js",
    "audit:members": "tsx scripts/auditGroupMembers.ts",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') { require('child_process').execSync('husky', {stdio: 'inherit'}) }\""
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@grammyjs/conversations": "^2.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "chrono-node": "^2.10.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "got": "^16.2.0",
    "grammy": "^1.48.0",
    "ical-generator": "^11.1.4",
    "metascraper": "^5.58.7",
    "metascraper-date": "^5.58.7",
    "metascraper-description": "^5.58.7",
    "metascraper-image": "^5.58.7",
    "metascraper-title": "^5.58.7",
    "metascraper-url": "^5.58.7",
    "minimatch": "^11.0.9",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "puppeteer-core": "^25.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.10",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
